{
  "name": "linkpulse-backend",
  "version": "0.1.0",
  "description": "LinkPulse API: URL shortener with click analytics",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node-pg-migrate -m migrations --envPath .env",
    "migrate:test": "node-pg-migrate -m migrations --envPath .env --database-url-var TEST_DATABASE_URL up",
    "pretest": "npm run migrate:test",
    "test": "jest --runInBand",
    "test:coverage": "npm run migrate:test && jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup-env.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "author": "Houssem Eddine Chaouch",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
