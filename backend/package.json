{
  "name": "linkpulse-backend",
  "version": "0.1.0",
  "description": "LinkPulse API: URL shortener with click analytics",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/srever.js",
    "dev": "nodemon src/srever.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "migrate": "node-pg-migrate -m migrations --envPath .env"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "author": "Houssem Eddine Chaouch",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
